# =============================================================================
# AI Accelerator — root environment, consumed by docker-compose for
# variable substitution. Copy to `.env` and fill in. For local (non-Docker)
# `make dev`, each service reads its own apps/<svc>/.env (see each app's
# .env.example).
# =============================================================================

# Deployment environment: local | dev | staging | prod   (sandbox=4 is reserved)
# Drives the trace_id env nibble and the `env` field on every log line.
APP_ENV=local

# ── Observability (shared across all services) ───────────────────────────────
# Leave EMPTY to run in DEGRADED mode: structured stdout logs only, no remote
# export, no crash (each service prints a clear startup WARNING and reports
# "observability": "disabled" on /health). Set it to your Application Insights
# connection string to ship telemetry to Azure Monitor + Log Analytics. The
# same code path runs locally and when deployed.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Fixed-percentage trace sampling ratio, 0..1 (all services). Empty/unset = 1.0
# (100% — sampling is PINNED; the distros' silent rate-limited default of
# ~5 traces/sec is never used). Invalid values warn and fall back to 1.0.
# The standard OTEL_TRACES_SAMPLER / OTEL_TRACES_SAMPLER_ARG env vars take
# precedence over this knob when set.
TRACE_SAMPLING_RATIO=

# Telemetry ingestion auth mode, all services (Phase 4 hardening). Values:
#   (empty) | connection_string  -> connection-string ingestion (default)
#   managed_identity             -> Microsoft Entra ID ingestion via managed
#     identity (needs "Monitoring Metrics Publisher" on the App Insights
#     component; pairs with DisableLocalAuth — see infra/README.md). Only
#     meaningful when deployed to Azure — local Docker has no managed identity.
# ANY other value disables observability VISIBLY (reason on /health) — there
# is never a silent fallback to unauthenticated ingestion.
TELEMETRY_AUTH_MODE=
# Client ID of a USER-ASSIGNED managed identity (empty = system-assigned).
TELEMETRY_MANAGED_IDENTITY_CLIENT_ID=

# ── Database (api / SQLAlchemy 2 async → Azure SQL Database, ADR-0008) ─────
# THERE IS NO LOCAL DATABASE — every database is Azure SQL, created by the
# use-case Bicep deployment first (infra/main.bicep). Get the dev URL from Key Vault (secret DATABASE-URL). The
# engine is lazy (nothing connects until the first query), so the baseline
# boots fine with this placeholder. Scheme mssql+aioodbc://, ODBC Driver 18,
# Encrypt=yes, TrustServerCertificate=no. Migrations (Alembic) are never run
# automatically — see apps/api/README.md.
DATABASE_URL=mssql+aioodbc://USER:PASSWORD@your-server.database.windows.net:1433/your-database?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
# Optional READ-ONLY external Azure SQL database (empty = not configured).
EXTERNAL_DATABASE_URL=

# ── AI runtime (api — LangChain + LangGraph on Azure AI Foundry, ADR-0009) ──
# All optional locally; see apps/api/.env.example for the full description.
AZURE_AI_ENDPOINT=
AZURE_AI_DEPLOYMENT=
AZURE_AI_EMBEDDING_DEPLOYMENT=
AZURE_AI_EMBEDDING_DIMENSIONS=1536
AZURE_AI_API_VERSION=2024-10-21
AZURE_AI_AUTH_MODE=managed_identity
AZURE_AI_API_KEY=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=
AZURE_SEARCH_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_ALLOW_TEXT_TO_SQL=false

# -----------------------------------------------------------------------------
# Service ports: web=3000, api=8000.
# The service-to-service URL (API_BASE_URL) and OTEL_SERVICE_NAME are set per
# service in docker-compose.yml via compose DNS (http://api:8000) — no need
# to set them here.
# -----------------------------------------------------------------------------
