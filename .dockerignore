# Root .dockerignore: governs every build whose context is the repository root, i.e. the api image
# (`docker build --file apps/api/Dockerfile .`). The web image builds from apps/web, which has its own.
node_modules/
**/node_modules/
dist/
**/dist/
.next/
**/.next/
**/generated/
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.pyc
.git/
.gitignore
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.pfx
**/.azure/
**/*.log
# The api image is built from the repository root (apps/api/Dockerfile): keep out what it never uses.
apps/web/
infra/
roadmaps/
.claude/
.github/
team-assistant/
**/coverage/
**/coverage.xml
**/*.spec.ts
**/test/
**/.ruff_cache/
**/.pytest_cache/
**/.cache/
