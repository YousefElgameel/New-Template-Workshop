# =============================================================================
# Team Assistant — web — environment variables (SERVER-SIDE ONLY).
# Never expose service URLs or secrets via NEXT_PUBLIC_* — the browser only
# ever talks to this Next server (BFF), which calls the api service server-side.
# Copy to `.env.local` for local dev.
# =============================================================================

# Deployment environment. One of: local | dev | staging | prod | sandbox.
# Drives the env hex digit in the trace_id (local=0,dev=1,staging=2,prod=3,sandbox=4).
# Unknown/missing is treated as local (0).
APP_ENV=local

# Azure Application Insights connection string.
# Leave EMPTY to run in degraded mode (local stdout logging only, no remote export).
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Fixed-percentage trace sampling ratio, 0..1. Empty/unset = 1.0 (100% —
# sampling is PINNED; the distro's silent rate-limited default of ~5
# traces/sec is never used). Invalid values warn and fall back to 1.0. The
# standard OTEL_TRACES_SAMPLER / OTEL_TRACES_SAMPLER_ARG take precedence.
TRACE_SAMPLING_RATIO=

# Telemetry ingestion auth mode (Phase 4 hardening). Values:
#   (empty) | connection_string  -> connection-string ingestion (default)
#   managed_identity             -> Microsoft Entra ID ingestion via the app's
#     managed identity (needs "Monitoring Metrics Publisher" on the App
#     Insights component; pairs with DisableLocalAuth — see infra/README.md).
# ANY other value disables observability VISIBLY (reason on /health) — there
# is never a silent fallback to unauthenticated ingestion.
TELEMETRY_AUTH_MODE=
# Client ID of a USER-ASSIGNED managed identity (empty = system-assigned).
TELEMETRY_MANAGED_IDENTITY_CLIENT_ID=

# OpenTelemetry / Azure Monitor cloud role (service) name (defaulted in code
# when unset; never overrides an operator-provided value). The cloud role
# INSTANCE (service.instance.id) is also defaulted automatically:
# container replica name → HOSTNAME → os hostname.
OTEL_SERVICE_NAME=team-assistant-web

# Upstream service base URL (server-side only — consumed by the BFF routes).
# The api (FastAPI) service is the sole backend; in docker-compose this is
# overridden to http://api:8000.
API_BASE_URL=http://localhost:8000

# Asks the BFF lets run at once: in total for this instance, and per client (the rightmost X-Forwarded-For
# address; one shared bucket when there is none). One more is refused with 429 busy. 1..1000; a mistyped
# value is the default, never "no limit". Per instance: each replica has its own count.
ASK_MAX_INFLIGHT=8
ASK_MAX_INFLIGHT_PER_CLIENT=2
# Proxies in front of the ingress that append their own address to X-Forwarded-For (a Front Door, a gateway):
# the client is then that many entries from the right. 0..5; anything else is 0 (the rightmost).
ASK_TRUSTED_PROXY_HOPS=0

# Offline work only: `true` makes the /api/v1/conversations routes (and so the /chat page) serve the fixtures in
# src/mocks/ instead of calling the api, and every mocked response carries `x-mock-upstream: true`. OFF by default: leave
# it unset (or `false`) to run against the real api. Ignored, with an error log, when APP_ENV is prod. Server-side
# only, never NEXT_PUBLIC_*. A leftover `true` in your own `.env`/`.env.local` overrides this file: remove it.
MOCK_UPSTREAM=

# Port the Next server listens on (web=3000 per the shared contract).
PORT=3000
