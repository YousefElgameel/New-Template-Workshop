# =============================================================================
# Team Assistant — api (FastAPI) — environment configuration
# Copy to `.env` and adjust. All values below are safe local defaults.
# =============================================================================

# Deployment environment. Drives the env-hex segment of the trace id.
#   local=0, dev=1, staging=2, prod=3, sandbox=4
# Unknown / missing is treated as "local" (0).
APP_ENV=local

# Azure Application Insights connection string.
# Leave EMPTY to run in degraded mode (local stdout logging only; observability
# reported as "disabled"). Set a real connection string to enable Azure Monitor.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Fixed-percentage trace sampling ratio, 0..1. Empty/unset = 1.0 (100% —
# sampling is PINNED; the distro's silent rate-limited default of ~5
# traces/sec is never used). Invalid values warn and fall back to 1.0. The
# standard OTEL_TRACES_SAMPLER / OTEL_TRACES_SAMPLER_ARG take precedence.
TRACE_SAMPLING_RATIO=

# Telemetry ingestion auth mode (Phase 4 hardening). Values:
#   (empty) | connection_string  -> connection-string ingestion (default)
#   managed_identity             -> Microsoft Entra ID ingestion via the app's
#     managed identity (needs "Monitoring Metrics Publisher" on the App
#     Insights component; pairs with DisableLocalAuth — see infra/README.md).
# ANY other value disables observability VISIBLY (reason on /health) — there
# is never a silent fallback to unauthenticated ingestion.
TELEMETRY_AUTH_MODE=
# Client ID of a USER-ASSIGNED managed identity (empty = system-assigned).
TELEMETRY_MANAGED_IDENTITY_CLIENT_ID=

# OpenTelemetry service name reported to Azure Monitor (defaulted in code when
# unset; never overrides an operator-provided value). The cloud role INSTANCE
# (service.instance.id) is also defaulted automatically: container replica
# name → HOSTNAME → hostname.
OTEL_SERVICE_NAME=team-assistant-api

# ── Database (SQLAlchemy 2 async + aioodbc → Azure SQL Database, ADR-0008) ───
# THERE IS NO LOCAL DATABASE. The project's database is created on Azure by
# the use-case Bicep deployment first (infra/main.bicep); get the dev URL from Key Vault (secret DATABASE-URL) and
# paste it here. The engine is LAZY: no connection is opened until the first
# query, so the baseline boots even with this placeholder.
# Scheme mssql+aioodbc:// ; the query string is forwarded to the ODBC connection
# string: driver (spaces as `+`), Encrypt=yes, TrustServerCertificate=no, and
# for deployed apps Authentication=ActiveDirectoryMsi with the identity's client
# id as the username (infra/main.bicep writes that form to Key Vault). Local dev against Azure SQL
# uses SQL auth (USER:PASSWORD — URL-encode reserved characters) or
# Authentication=ActiveDirectoryServicePrincipal (UID=client id, PWD=secret).
# Migrations are never run automatically (see alembic.ini).
DATABASE_URL=mssql+aioodbc://USER:PASSWORD@your-server.database.windows.net:1433/your-database?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

# Optional READ-ONLY external database (another Azure SQL database the project
# does not own). Empty = not configured (no placeholder on purpose — the
# external engine refuses to build). Use the SELECT-only login the owner
# provides; add ApplicationIntent=ReadOnly when the source has read replicas.
EXTERNAL_DATABASE_URL=

# ── AI runtime (LangChain + LangGraph on Azure AI Foundry, ADR-0009) ─────────
# Everything is optional: with nothing set the service boots and the AI layer
# raises AINotConfigured only when a feature actually calls it.
# The AI Services (Foundry) account endpoint, e.g. https://ais-<slug>-dev.cognitiveservices.azure.com/
AZURE_AI_ENDPOINT=
# Chat and embedding deployment names on the SHARED Foundry (infra/platform/<env>.json → aiFoundry.deployments).
AZURE_AI_DEPLOYMENT=
AZURE_AI_EMBEDDING_DEPLOYMENT=
# Vector width of the embedding deployment (1536 for text-embedding-3-small/ada-002, 3072 for -large).
# The Team Assistant index is built at 3072 (text-embedding-3-large, decision 20). Ingestion stops, and
# changes nothing, if the deployment or an existing index has another size.
AZURE_AI_EMBEDDING_DIMENSIONS=3072
# Directory of the .md corpus the ingestion job reads. Empty = /app/corpus when APP_ENV is not local and the
# image has one (the repo's docs, baked in at build time, ADR-0013), else the repository's docs/.
CORPUS_DIR=
# A run refuses before it embeds anything when the corpus has more .md files than this, or more bytes in
# total (threat model G7). 1000 files / 52428800 bytes (50 MiB) when unset; a mistyped value is the default.
INGEST_MAX_FILES=1000
INGEST_MAX_BYTES=52428800
# The shared secret of POST /v1/admin/ingest (ADR-0015): the x-admin-key header must equal it. Empty, or under
# 32 characters, means the endpoint answers 401 to everyone (it fails closed). Generate a long random value
# (for example `python -c "import secrets; print(secrets.token_urlsafe(48))"`); Key Vault when deployed,
# your own .env locally; never commit a real value. Rotation: docs/operations/runbooks/rotate-ingest-admin-key.md
INGEST_ADMIN_KEY=
# Azure OpenAI API version.
AZURE_AI_API_VERSION=2024-10-21
# managed_identity (deployed default; DefaultAzureCredential + AZURE_CLIENT_ID) | api_key (dev only).
# ANY other value raises at startup of the AI layer — no silent fallback.
AZURE_AI_AUTH_MODE=managed_identity
# Only with AZURE_AI_AUTH_MODE=api_key — from Key Vault (AZURE-AI-API-KEY), never committed.
AZURE_AI_API_KEY=
# Azure AI Search (the vector/hybrid store, D7) — endpoint + index the ingestion job built.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=
# Dev only (Key Vault AZURE-SEARCH-API-KEY); empty = the app's identity (Search Index Data Reader).
AZURE_SEARCH_API_KEY=
# Per-call model timeout (seconds) and retries — explicit, never unbounded. One answer's worst case is
# timeout x (retries + 1) + 2 x AI_RETRIEVAL_TIMEOUT_SECONDS = 180 s here; Azure Container Apps ingress cuts a
# request at 240 s (fixed), so keep that sum at or under 220 s (the api warns at startup if it is over).
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=1
# The longest answer the model may write (tokens), the time each retrieval step may take (seconds),
# and how many asks may run at once in this process (one more is refused with 429 busy).
AI_MAX_OUTPUT_TOKENS=1024
AI_RETRIEVAL_TIMEOUT_SECONDS=30
AI_MAX_CONCURRENT_ASKS=4
# The largest request body (bytes) any /v1 route accepts; a bigger one is refused with 413 before it is
# read (default 65536, at most 1048576). A mistyped, non-positive or larger value is the default,
# never "no cap". Only /ping, /info and /health (no body) are exempt.
MAX_REQUEST_BODY_BYTES=65536
# Let the model run free-form SELECTs against the external DB. OFF by default; a
# threat-modelled project decision (the engine guard + SELECT-only login still apply).
AI_ALLOW_TEXT_TO_SQL=false

# Port this service listens on (shared contract: api=8000).
PORT=8000
