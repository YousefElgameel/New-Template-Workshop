{
  "components": {
    "schemas": {
      "AskIn": {
        "additionalProperties": false,
        "properties": {
          "question": {
            "description": "The question. Not blank; at most 4,000 characters.",
            "title": "Question",
            "type": "string"
          }
        },
        "required": ["question"],
        "title": "AskIn",
        "type": "object"
      },
      "AskOut": {
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "citations": {
            "description": "The retrieved documents the answer cites, each once, in citation order; empty when it cites none. Titles and paths are untrusted text: show them as plain text.",
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "title": "Citations",
            "type": "array"
          },
          "message_id": {
            "description": "The stored assistant message.",
            "format": "uuid",
            "title": "Message Id",
            "type": "string"
          }
        },
        "required": ["message_id", "answer", "citations"],
        "title": "AskOut",
        "type": "object"
      },
      "Citation": {
        "properties": {
          "path": {
            "title": "Path",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": ["title", "path"],
        "title": "Citation",
        "type": "object"
      },
      "ConversationCreate": {
        "additionalProperties": false,
        "properties": {
          "title": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional. Blank or missing → \"New conversation\", replaced by the first question.",
            "title": "Title"
          }
        },
        "title": "ConversationCreate",
        "type": "object"
      },
      "ConversationDetail": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "messages": {
            "description": "Oldest first, ordered by thread position.",
            "items": {
              "$ref": "#/components/schemas/MessageOut"
            },
            "title": "Messages",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "truncated": {
            "description": "True when only the most recent messages are returned: the conversation holds more than 500 messages, or they add up to more than about 4 MiB of text (UTF-8 bytes of content and citations); the newest message is always returned.",
            "title": "Truncated",
            "type": "boolean"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": ["id", "title", "created_at", "updated_at", "messages", "truncated"],
        "title": "ConversationDetail",
        "type": "object"
      },
      "ConversationList": {
        "properties": {
          "count": {
            "description": "Number of items returned (not a total).",
            "title": "Count",
            "type": "integer"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ConversationListItem"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": ["items", "count"],
        "title": "ConversationList",
        "type": "object"
      },
      "ConversationListItem": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": ["id", "title", "updated_at"],
        "title": "ConversationListItem",
        "type": "object"
      },
      "ConversationOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": ["id", "title", "created_at", "updated_at"],
        "title": "ConversationOut",
        "type": "object"
      },
      "ErrorBody": {
        "description": "The one error shape every api response uses.",
        "properties": {
          "error": {
            "description": "Stable snake_case code, e.g. not_found, validation_error.",
            "title": "Error",
            "type": "string"
          },
          "trace_id": {
            "description": "The request's trace id — the same value as the x-trace-id header.",
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": ["error", "trace_id"],
        "title": "ErrorBody",
        "type": "object"
      },
      "IngestStarted": {
        "properties": {
          "status": {
            "const": "started",
            "default": "started",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "IngestStarted",
        "type": "object"
      },
      "MessageOut": {
        "properties": {
          "citations": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Citation"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Documents the answer cites; null for user messages.",
            "title": "Citations"
          },
          "content": {
            "title": "Content",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "enum": ["user", "assistant"],
            "title": "Role",
            "type": "string"
          }
        },
        "required": ["id", "role", "content", "created_at"],
        "title": "MessageOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Team Assistant — api",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Health endpoint reporting observability state.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/info": {
      "get": {
        "description": "Consolidated status + version + runtime report for this service.\n\nExtends the /health shape with the build version and runtime/system\nmetadata. Reachable only via the BFF (web) on the internal network.",
        "operationId": "info_info_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Info Info Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Info"
      }
    },
    "/ping": {
      "get": {
        "description": "Liveness greeting endpoint.",
        "operationId": "ping_ping_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Ping Ping Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ping"
      }
    },
    "/v1/admin/ingest": {
      "post": {
        "description": "Ingest the corpus; the outcome is in the log and the `ingest.completed` event.",
        "operationId": "start_ingest_v1_admin_ingest_post",
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestStarted"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Missing, wrong or unset key (`unauthorized`)"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A run is already in progress (`ingest_running`)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Validation failed (`validation_error`)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unhandled error (`internal_error`)"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Search or embeddings not configured (`ai_unavailable`)"
          }
        },
        "summary": "Start an ingestion run in the background",
        "tags": ["admin"]
      }
    },
    "/v1/conversations": {
      "get": {
        "operationId": "list_conversations_v1_conversations_get",
        "parameters": [
          {
            "description": "1-100.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "description": "1-100.",
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Validation failed (`validation_error`)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unhandled error (`internal_error`)"
          }
        },
        "summary": "List conversations, newest first",
        "tags": ["conversations"]
      },
      "post": {
        "operationId": "create_conversation_v1_conversations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ConversationCreate"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Validation failed (`validation_error`)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unhandled error (`internal_error`)"
          }
        },
        "summary": "Start a conversation",
        "tags": ["conversations"]
      }
    },
    "/v1/conversations/{conversation_id}": {
      "get": {
        "operationId": "get_conversation_v1_conversations__conversation_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No such conversation (`not_found`)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Validation failed (`validation_error`)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unhandled error (`internal_error`)"
          }
        },
        "summary": "Open a conversation with its messages",
        "tags": ["conversations"]
      }
    },
    "/v1/conversations/{conversation_id}/ask": {
      "post": {
        "operationId": "ask_question_v1_conversations__conversation_id__ask_post",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No such conversation (`not_found`)"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The question is too long (`payload_too_large`)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Validation failed (`validation_error`)"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Too many asks at once (`busy`)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unhandled error (`internal_error`)"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The model or the search did not answer, or the AI layer is not configured (`ai_unavailable`). The question is kept; no answer is stored."
          }
        },
        "summary": "Ask a question; the answer cites the docs",
        "tags": ["conversations"]
      }
    },
    "/v1/conversations/{conversation_id}/ask/stream": {
      "post": {
        "operationId": "ask_stream_v1_conversations__conversation_id__ask_stream_post",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Server-sent events. `sources` (`{sources: [{title, path}], count}`: every retrieved document, sent as soon as retrieval ends), then `token` (`{text}`) repeated, then `done` (`{message_id, input_tokens, output_tokens, citations}`: `citations` are the cited documents, exactly as stored) **or** `error` (`{error_kind, error, trace_id}`: the stream ends and no answer is stored). A bad request, an unknown conversation and a busy server are ordinary JSON errors before the stream starts."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No such conversation (`not_found`)"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The question is too long (`payload_too_large`)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Validation failed (`validation_error`)"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Too many asks at once (`busy`)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unhandled error (`internal_error`)"
          }
        },
        "summary": "Ask a question; the answer streams in",
        "tags": ["conversations"]
      }
    }
  }
}
